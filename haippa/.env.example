# Database
DATABASE_URL="postgresql://user:password@localhost:5432/haippa"

# Auth
SESSION_SECRET="change-this-to-a-long-random-secret-min-32-chars"

# Storage (Cloudflare R2 or AWS S3)
S3_BUCKET="haippa-uploads"
S3_REGION="auto"
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"
NEXT_PUBLIC_S3_PUBLIC_URL="https://cdn.haippa.com"

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="HAIPPA <hello@haippa.com>"

# Payments (set to "mock" for dev, "stripe" for production)
PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxx"

# App
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
